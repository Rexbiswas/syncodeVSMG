# ==============================================================================
# SYNCODE - Environment Configuration Template
# Copy this file to .env before starting the development environment.
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Global Environment Mode: development | production | test
NODE_ENV=development

# Structured Pino Log Level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Backend REST API Service (NestJS)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Application (Next.js 16)
# IMPORTANT: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ------------------------------------------------------------------------------
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=SYNCODE
NEXT_PUBLIC_APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Real-Time Collaboration Service (Node.js / Yjs Foundation)
# ------------------------------------------------------------------------------
COLLABORATION_PORT=4001
COLLABORATION_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database (PostgreSQL & Prisma ORM)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncode
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncode?schema=public"

# ------------------------------------------------------------------------------
# Cache & Message Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

