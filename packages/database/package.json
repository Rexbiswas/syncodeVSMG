{
  "name": "@syncode/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database access layer with Prisma ORM and PostgreSQL for SYNCODE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@syncode/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
